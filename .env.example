# Optional: Formspree endpoint (e.g., https://formspree.io/f/your_form_id)
# If provided, submissions will be sent directly to Formspree
NEXT_PUBLIC_FORMSPREE_ENDPOINT=

# Optional: Web3Forms access key (e.g., from https://web3forms.com)
# If provided, submissions will be posted to Web3Forms API
NEXT_PUBLIC_WEB3FORMS_KEY=
